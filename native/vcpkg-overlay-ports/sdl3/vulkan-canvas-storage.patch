+/* Allocation capability only: this does not expose additional SDL storage bindings. */
+static bool VULKAN_INTERNAL_CanvasStorageSupported(
+    VulkanRenderer *renderer,
+    VkFormat format,
+    VkImageUsageFlags usage,
+    Uint32 width,
+    Uint32 height)
+{
+    VkImageFormatProperties properties;
+    const VkResult result = renderer->vkGetPhysicalDeviceImageFormatProperties(
+        renderer->physicalDevice, format, VK_IMAGE_TYPE_2D, VK_IMAGE_TILING_OPTIMAL,
+        usage | VK_IMAGE_USAGE_STORAGE_BIT, 0, &properties);
+    return result == VK_SUCCESS &&
+        width <= properties.maxExtent.width && height <= properties.maxExtent.height &&
+        properties.maxExtent.depth >= 1 && properties.maxMipLevels >= 1 &&
+        properties.maxArrayLayers >= 1 && (properties.sampleCounts & VK_SAMPLE_COUNT_1_BIT);
+}
